{
  "name": "community-directory",
  "version": "1.0.0",
  "private": true,
  "description": "A static directory for promoting Discord communities.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-og.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "next lint",
    "add": "node scripts/add-community.mjs",
    "refresh": "node scripts/refresh.mjs",
    "check": "node scripts/check-data.mjs",
    "check:name": "node scripts/check-name.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run check && npm run build && npm run check:name && npm test"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
